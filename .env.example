# ------------------------------------------------------------------
# NEXUS-COMPLY Environment Configuration
# ------------------------------------------------------------------

# --- API (Node/Express) ---
PORT=4000
NODE_ENV=development

# Data storage backend: "json" (zero-infra, default) | "postgres"
STORAGE_BACKEND=json

# Only used when STORAGE_BACKEND=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_comply

# --- AI Service (Python/FastAPI) ---
AI_SERVICE_URL=http://localhost:8000

# --- AI Provider ---
# mock  -> deterministic demo mode (no API key required, DEFAULT)
# openai -> OpenAI chat completions
# gemini -> Google Gemini
# openrouter -> OpenRouter-compatible endpoint
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# --- Web (Vite) ---
# Defaults to "/api" (same origin) when unset. For hosted deployments (e.g.
# Vercel) set this to the deployed API origin, e.g. VITE_API_URL=https://api.example.com
VITE_API_URL=http://localhost:4000
