# ------------------------------------------------------------------
# NEXUS-COMPLY Environment Configuration
# ------------------------------------------------------------------

# --- API (Node/Express) ---
PORT=4000
NODE_ENV=development

# Secret used to HMAC-sign auth tokens. Set a long random value in EVERY
# deployment (Vercel: Project Settings -> Environment Variables). When unset,
# a shared development secret is used so tokens verify across serverless
# instances, but you MUST set this for real security.
AUTH_SECRET=change-me-to-a-long-random-string

# Where the API persists data. "json" = data/db.json (zero-infra, default).
# On Vercel serverless this is set automatically to /tmp/nexus-data.
STORAGE_BACKEND=json

# Only used when STORAGE_BACKEND=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_comply

# --- AI Service (Python/FastAPI) ---
AI_SERVICE_URL=http://localhost:8000

# --- AI Provider ---
# mock  -> deterministic demo mode (no API key required, DEFAULT)
# openai -> OpenAI chat completions
# gemini -> Google Gemini
# openrouter -> OpenRouter-compatible endpoint
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# --- Web (Vite) ---
# Resolved at BUILD time by Vite. Leave this EMPTY/omitted for:
#   - local dev        -> "/api" proxied by the Vite dev server to :4000
#   - Vercel           -> "/api" served by the serverless Function (same origin)
# Set it to the deployed API origin ONLY when the frontend is hosted statically
# and the backend runs on a separate host (e.g. GitHub Pages + Render/Railway):
# VITE_API_URL=https://nexus-api.example.com
# VITE_API_URL=
