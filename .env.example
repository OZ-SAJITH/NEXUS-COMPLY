# ------------------------------------------------------------------
# NEXUS-COMPLY Environment Configuration
# ------------------------------------------------------------------

# --- API (Node/Express) ---
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed by CORS (Cross-Origin Resource
# Sharing). Includes the GitHub Pages frontend and local dev servers by
# default. Add any other frontends that call this API, or your own list:
# CORS_ORIGINS=https://OZ-SAJITH.github.io,http://localhost:5173

# Authentication is removed: every request runs as the built-in Security
# Review Lead, so no AUTH_SECRET or demo accounts are required.

# Where the API persists data. "json" = data/db.json (zero-infra, default).
# On Vercel serverless this is set automatically to /tmp/nexus-data.
STORAGE_BACKEND=json

# Only used when STORAGE_BACKEND=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_comply

# --- AI Service (Python/FastAPI) ---
# Host of the FastAPI interpretation service (only needed when AI_PROVIDER is
# not "mock"). Leave as-is for the default local dev URL.
AI_SERVICE_URL=http://localhost:8000

# --- AI Provider ---
# mock  -> deterministic demo mode (no API key required, DEFAULT)
# openai -> OpenAI chat completions
# gemini -> Google Gemini
# openrouter -> OpenRouter-compatible endpoint
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# --- Web (Vite) ---
# Resolved at BUILD time by Vite. Leave this EMPTY/omitted for:
#   - local dev        -> "/api" proxied by the Vite dev server to :4000
#   - Vercel           -> "/api" served by the serverless Function (same origin)
# IMPORTANT: on GitHub Pages the backend cannot run on the same origin. The
# Pages workflow reads this value from the repository VARIABLE VITE_API_URL
# (Settings -> Secrets and variables -> Actions -> Variables) and injects it
# at build time. If it is unset, production shows a clear "API configuration
# required" banner instead of silently calling /api.
# Set it to the deployed API origin (include "/api" only if your host serves
# routes under that prefix, e.g. https://nexus-api.example.com):
# VITE_API_URL=https://nexus-api.example.com
# VITE_API_URL=

# Optional: URL of the hosted FastAPI AI service probed by the frontend to
# show "mock" vs "live" mode. Only honored in dev/localhost if unset.
# VITE_AI_URL=https://nexus-ai.example.com
# VITE_AI_URL=
